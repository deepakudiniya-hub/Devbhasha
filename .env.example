# ---------------------------------------------------------------------------
# Devbhasha — example environment file.
#
# SECURITY: this file is committed to the repository. It must contain
# PLACEHOLDERS ONLY. Never put a real key here.
#
# Real values live in `.env` (git-ignored) locally, and in your CI/CD secret
# store or a Firebase Functions secret for deployed builds.
#
#   Local dev  : copy this file to `.env` and fill in real values.
#   CI / prod  : inject via the secret store — do NOT commit `.env`.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: injected at runtime by AI Studio / server-side capability.
# Leave commented so it is never packaged into the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Agora RTC App ID (32 hex chars). Placeholder — set the real value in `.env`.
AGORA_APP_ID=YOUR_AGORA_APP_ID

# Razorpay KEY ID (public, safe to ship in the app). Placeholder only.
# The Razorpay KEY SECRET must NEVER appear in this app — it lives only in the
# Cloud Function secret (RAZORPAY_KEY_SECRET).
RAZORPAY_KEY=YOUR_RAZORPAY_KEY
