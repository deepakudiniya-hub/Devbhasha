      },
      "medium": {
        "$type": "color",
        "$value": "#DBDBDB",
        "$description": "Bottom nav top border"
      }
    },
    "neutral": {
      "navPill": {
        "$type": "color",
        "$value": "#F5F5F5"
      },
      "pillActive": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Active filter pill (white text)"
      }
