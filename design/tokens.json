{
  "$description": "Devbhasha design tokens — the single source of truth for both Figma (Tokens Studio) and the Android app. Edit HERE, then run design/generate_kotlin.py. Never hand-edit the generated Kotlin.",
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "core"
    ]
  },
  "color": {
    "bg": {
      "primary": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "All screens background"
      },
      "secondary": {
        "$type": "color",
        "$value": "#FAFAFA",
        "$description": "Search bars, inputs, inactive pills"
      },
      "card": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Card surface (1px border #EFEFEF)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Headings, names, prices"
      },
      "secondary": {
        "$type": "color",
        "$value": "#737373",
        "$description": "Subtitles, bio, timestamps"
      },
      "tertiary": {
        "$type": "color",
        "$value": "#A8A8A8",
        "$description": "Placeholders, disabled"
      },
      "inverse": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text on dark / saffron fills"
      }
    },
    "accent": {
