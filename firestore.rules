rules_version = '2';

// Devbhasha & Devsadhak Firestore security rules.
// Client is untrusted. Money, pricing, sessions and verification are written
// only by Cloud Functions (Admin SDK bypasses these rules).
// Admin = custom claim request.auth.token.admin == true.
// Anything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Seeker profile fields the client may never set.
    function userProtectedKeys() {
      return ['walletBalance', 'balance', 'referralCode', 'referredBy',
              'referralBonusClaimed', 'totalReferralEarnings', 'freeTrialUsed',
              'role', 'admin', 'isAdmin', 'roles', 'verified', 'blocked', 'status', 'accountStatus', 'reservedBalance', 'deletionPending'];
    }

    // Provider/sadhak fields the client may never set.
    function providerProtectedKeys() {
      return ['verified', 'verificationStatus', 'verifiedAt', 'verifiedBy',
              'rating', 'ratingCount', 'ratingSum', 'reviewCount', 'totalReviews', 'kycStatus', 'reviewedBy', 'reviewedAt', 'deletionPending',
              'earnings', 'totalEarnings', 'balance', 'walletBalance',
              'payout', 'payouts', 'payoutBalance', 'pendingPayout', 'payoutStatus',
              'totalPayout', 'totalPaidOut', 'lastPayoutAt', 'payoutAmount',
              'role', 'admin', 'isAdmin', 'roles', 'blocked', 'disabled', 'approved',
              'phone', 'phoneNumber', 'email', 'fcmToken', 'idProofUrl', 'idProofPath', 'docUrl', 'selfieUrl', 'panNumber', 'accountNumber', 'bankDetails',
              'consentVersion', 'consentAt', 'agreementAccepted', 'acceptedAgreementVersion', 'agreementAcceptedAt', 'hasAcceptedAgreement'];
    }

    function validRates() {
      return (!('chatPricePerMin' in request.resource.data) || (request.resource.data.chatPricePerMin is int && request.resource.data.chatPricePerMin >= 5 && request.resource.data.chatPricePerMin <= 100))
        && (!('callPricePerMin' in request.resource.data) || (request.resource.data.callPricePerMin is int && request.resource.data.callPricePerMin >= 5 && request.resource.data.callPricePerMin <= 100))
        && (!('sessionPrice30Min' in request.resource.data) || (request.resource.data.sessionPrice30Min is int && request.resource.data.sessionPrice30Min >= 199 && request.resource.data.sessionPrice30Min <= 2999));
    }
    // Admins may read everything (writes are granted per collection below;
    // money collections stay functions-only even for admins).
    match /{collection}/{document=**} {
      allow read: if isAdmin() && !(collection in ['payout_destinations', 'freeTrialClaims']);
    }

    // ----------------------------------------------------------- seekers
    // Self read. Self may create/update profile fields, never wallet/referral/role.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
                    && !request.resource.data.keys().hasAny(userProtectedKeys());
      allow update: if isSelf(uid)
                    && !changedKeys().hasAny(userProtectedKeys());
      // Admin panel (status suspend/activate, profile edits): never wallet/referral/trial fields.
      allow update: if isAdmin()
                    && !changedKeys().hasAny(['walletBalance', 'balance', 'referralCode', 'referredBy',
                                              'referralBonusClaimed', 'totalReferralEarnings', 'freeTrialUsed']);
      allow delete: if false;

      // Blocked users
      match /blocked/{id} {
        allow read, write: if isSelf(uid);
      }

      // Subcollections owned by this user (favorites, dreams, history, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ------------------------------------------------ money (functions only)
    match /payments/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /paymentOrders/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /walletLedger/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // Generic wallets/transactions collections, if ever used: functions only.
    match /wallets/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // freeTrialClaims/{phone}: no client access at all (default deny).

    // ---------------------------------------------------------- sessions
    // Created/extended/ended only by functions (startSession etc.).
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    // ------------------------------------------------------------- chats
    // chats/{sessionId} is created by startSession with participants[2].
    // Only participants read; messages only while the session is paid/active.
    match /chats/{chatId} {
      function chatParticipants() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
      function isParticipant() {
        return isSignedIn() && request.auth.uid in chatParticipants();
      }
      function sessionIsLive() {
        let s = get(/databases/$(database)/documents/sessions/$(chatId)).data;
        return (s.status == 'active' && request.time < s.endsAt) || (s.status == 'pending' && s.seekerId == request.auth.uid && request.time < s.acceptBy);
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
                    && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt'])
                    && request.resource.data.lastSenderId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isParticipant();
        allow create: if isParticipant()
                      && exists(/databases/$(database)/documents/sessions/$(chatId))
                      && sessionIsLive()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.keys().hasOnly(
                           ['id', 'senderId', 'senderName', 'text', 'timestamp', 'type', 'imageUrl',
                            'fromUser', 'isFromUser', 'formattedTime', 'expireAt'])
                      && request.resource.data.expireAt is timestamp
                      && request.resource.data.expireAt >= request.time + duration.value(365, 'd') - duration.value(10, 'm')
                      && request.resource.data.expireAt <= request.time + duration.value(365, 'd') + duration.value(10, 'm');
        allow update, delete: if false;
      }
    }

    // --------------------------------------------------------- questions
    // Only the asking seeker and the assigned sadhak can read.
    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.providerId != request.auth.uid
                    && !request.resource.data.keys().hasAny(
                         ['sessionId', 'type', 'kind', 'earningAmount', 'amountPaise', 'chargedPaise', 'settled',
                          'settledAt', 'settlementStatus', 'answer', 'answeredAt']);
      allow update: if isSignedIn()
                    && resource.data.providerId == request.auth.uid
                    && resource.data.userId != request.auth.uid
                    && resource.data.status in ['pending', 'assigned']
                    && changedKeys().hasOnly(['answer', 'status', 'answeredAt', 'rejectedAt', 'rejectReason'])
                    && request.resource.data.status in ['assigned', 'answered', 'rejected'];
      allow delete: if false;

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------- live calls
    // Signalling only; no money is computed from this collection any more.
    match /active_calls/{callId} {
      allow read: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      ) && changedKeys().hasOnly(['status', 'durationSeconds', 'connectedAt', 'rejectedAt', 'endedAt', 'updatedAt'])
      && request.resource.data.status in ['ringing', 'CALLING', 'CONNECTED', 'REJECTED', 'ENDED', 'FAILED', 'MISSED', 'WAITING', 'ACCEPTED']
      && !changedKeys().hasAny(['earnedAmount', 'settled', 'settledAt', 'agoraToken']);
      allow delete: if false;
    }

    // ----------------------------------------------- sadhak directory
    match /sadhaks/{sadhakId} {
      allow read: if true;
      allow create: if false && (
        isSelf(sadhakId)
        && !request.resource.data.keys().hasAny(providerProtectedKeys())
        && request.resource.data.get('status', 'PENDING') == 'PENDING'
        && request.resource.data.get('isVerified', false) == false
      );
      allow delete: if isAdmin();
      allow update: if (
        isSelf(sadhakId)
        && changedKeys().hasOnly([
             'name', 'bio', 'photo', 'photoUrl', 'photoPath', 'rate', 'availability', 'isAvailable', 'isOnline',
             'lastActiveAt', 'updatedAt', 'chatPricePerMin', 'callPricePerMin', 'sessionPrice30Min'
           ])
        && (!('isAvailable' in request.resource.data) || request.resource.data.isAvailable is bool)
        && (!('isOnline' in request.resource.data) || request.resource.data.isOnline is bool)
        && (!('chatPricePerMin' in request.resource.data) || (request.resource.data.chatPricePerMin is int && request.resource.data.chatPricePerMin >= 5 && request.resource.data.chatPricePerMin <= 100))
        && (!('callPricePerMin' in request.resource.data) || (request.resource.data.callPricePerMin is int && request.resource.data.callPricePerMin >= 5 && request.resource.data.callPricePerMin <= 100))
        && (!('sessionPrice30Min' in request.resource.data) || (request.resource.data.sessionPrice30Min is int && request.resource.data.sessionPrice30Min >= 199 && request.resource.data.sessionPrice30Min <= 2999))
        && !changedKeys().hasAny(providerProtectedKeys())
      );
    }

    // ------------------------------------------------- provider profiles
    match /providers/{providerId} {
      allow read: if true;
      allow create: if isSelf(providerId)
        && !request.resource.data.keys().hasAny(providerProtectedKeys())
        && request.resource.data.get('status', 'PENDING') == 'PENDING'
        && request.resource.data.get('isVerified', false) == false;
      allow update: if isSelf(providerId)
        && !changedKeys().hasAny(providerProtectedKeys())
        && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
        && (request.resource.data.get('status', '') == resource.data.get('status', '')
          || (resource.data.get('status', '') in ['', 'REJECTED'] && request.resource.data.status == 'PENDING'))
        && validRates();
      allow delete: if false;

      // Sadhak private subcollection: phone, email, contact, device tokens.
      // Accessible ONLY by that specific Sadhak (isSelf) and admin. Seekers cannot read.
      match /private/{docId} {
        allow read: if isSelf(providerId) || isAdmin();
        allow create, update: if isSelf(providerId) && (
          docId in ['device', 'contact'] || (docId in ['kyc', 'verification'] &&
          (!exists(/databases/$(database)/documents/providers/$(providerId)) ||
          get(/databases/$(database)/documents/providers/$(providerId)).data.get('status', '') != 'APPROVED')));
        allow delete: if false;
      }

      match /jobs/{jobId} {
        allow read, write: if isSelf(providerId);
      }

      match /remedies/{remedyId} {
        allow read, write: if isSelf(providerId);
      }

      // Provider may file a request; only admin/functions change its status.
      match /payout_requests/{requestId} {
        allow read: if isSelf(providerId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /wallet/{docId} {
        allow read: if isSelf(providerId);
        allow write: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isSelf(providerId);
        allow write: if false;
      }
      // DevSadhak: provider notifications (server creates; sadhak can only mark read)
      match /notifications/{notificationId} {
        allow read: if isSelf(providerId);
        allow update: if isSelf(providerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow create, delete: if false;
      }
    }

    // Admin panel: logs, data requests, website enquiries (admin only)
    match /auditLogs/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /adminAuditLogs/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /activity_logs/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /dataRequests/{id} { allow read, write: if isAdmin(); }
    match /websiteEnquiries/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.createdAt == request.time;
    }

    // DevSadhak: reviews are written by the backend only
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow write: if false;
      // Admin panel moderation: hide/unhide only.
      allow update: if isAdmin()
                    && changedKeys().hasOnly(['hidden', 'hiddenReason', 'hiddenAt', 'hiddenBy']);
    }

    // ------------------------------------------------- content & comments
    match /card_contents/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /card_comments/{commentId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- consultation_requests
    match /consultation_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- consultation_history
    match /consultation_history/{historyId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /remedies/{remedyId} {
      allow read: if isSignedIn() && (resource.data.providerId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid
                    && (exists(/databases/$(database)/documents/providers/$(request.auth.uid)) || exists(/databases/$(database)/documents/sadhaks/$(request.auth.uid)))
                    && request.resource.data.keys().hasOnly(['id', 'providerId', 'userId', 'sessionId', 'devoteeName', 'remedyTitle', 'category', 'instruction', 'duration', 'status', 'timestamp'])
                    && request.resource.data.remedyTitle is string && request.resource.data.remedyTitle.size() <= 2000
                    && request.resource.data.instruction is string && request.resource.data.instruction.size() <= 2000;
      allow update: if isSignedIn() && resource.data.providerId == request.auth.uid
                    && changedKeys().hasOnly(['status', 'instruction', 'duration', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------- app_content
    match /app_content/{docId} {
      allow read: if true;
      allow write: if false;
      match /versions/{versionId} { allow read: if isAdmin(); allow write: if false; }
    }


    // ---------------------------------------------------- admin panel
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/private {
      allow read, write: if false;
    }

    match /notification_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------ support & waitlist
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();

      // Admin panel replies (admin-only; seeker-side access not defined here).
      match /messages/{messageId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /waitlist/{docId} {
      allow read, write: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ------------------------------------------------ sadhak agreement acceptances
    match /sadhakAgreementAcceptances/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.sadhakId == request.auth.uid));
      allow create: if false;
      allow update, delete: if false; // Immutable audit record
    }

    // ------------------------------------------------ community dream feed
    // Sirf admin-approved, verified saadhak (status/isVerified client set nahi kar sakta)
    function approvedSadhak() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/providers/$(request.auth.uid))
        && get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.get('status', '') == 'APPROVED'
        && get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.get('isVerified', false) == true;
    }
    // Count sirf 1 se badhe ya ghate, kabhi 0 se neeche nahi
    function countStep(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && (request.resource.data[field] - resource.data.get(field, 0)) in [-1, 1]);
    }
    function validSadhakSnippet(c) {
      return c is map && c.keys().hasOnly(['commentId', 'userId', 'authorName', 'text', 'timestamp', 'authorRole'])
        && c.userId == request.auth.uid && c.authorRole == 'sadhak'
        && c.text is string && c.text.size() > 0 && c.text.size() <= 10000;
    }
    match /public_dreams/{dreamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.dreamText is string
        && request.resource.data.dreamText.size() > 0 && request.resource.data.dreamText.size() <= 5000
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && !('topSadhakComment' in request.resource.data);
      allow update: if isSignedIn() && (
        // Koi bhi user: like / comment count +-1
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'likeCount'])
          && countStep('commentCount') && countStep('likeCount'))
        // Approved saadhak: apna jawab highlight + comment count +1
        || (approvedSadhak()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'topSadhakComment'])
          && countStep('commentCount')
          && validSadhakSnippet(request.resource.data.topSadhakComment))
        // Sapne ka maalik: apna text/tags badal sakta hai, counts aur highlight nahi
        || (resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'likeCount', 'commentCount', 'topSadhakComment']))
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      match /likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && likerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'timestamp'])
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && likerId == request.auth.uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000
          && request.resource.data.get('authorRole', 'user') in ['user', 'sadhak']
          // "sadhak" ke naam se sirf approved saadhak hi likh sakta hai
          && (request.resource.data.get('authorRole', 'user') != 'sadhak' || approvedSadhak())
          && (!('providerId' in request.resource.data) || request.resource.data.providerId == request.auth.uid);
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'authorRole', 'providerId']);
        allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ------------------------------------- topic FAQ: "आपका सवाल यहाँ नहीं है?"
    // Private inbox. Seeker may only create their own pending question; userId is
    // kept for abuse control and is readable by admins only. No name/phone fields.
    match /faq_questions/{questionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['topic', 'text', 'status', 'createdAt', 'userId'])
        && request.resource.data.keys().hasAll(['topic', 'text', 'status', 'createdAt', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.topic in ['family', 'wealth', 'negativity', 'pitrdosh', 'health']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Public, anonymised copy written by the admin panel on approval.
    // Only topic / question / answer / approvedAt: never a user identifier.
    match /faq_public/{publicId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['topic', 'question', 'answer', 'approvedAt'])
        && request.resource.data.question is string
        && request.resource.data.answer is string;
      allow delete: if isAdmin();
    }

    // Everything else: denied by default (no matching allow).
    match /payout_destinations/{providerId}/{document=**} {
      allow read, write: if false;
    }
    match /payout_access_log/{autoId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /deleted_providers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /account_deletions/{autoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /content_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    match /verse_library/{id} { allow read: if true; allow write: if isAdmin(); }
    match /verification_requests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow create: if isSelf(request.resource.data.providerId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.docType is string
        && request.resource.data.confirmationId is string
        && request.resource.data.keys().hasOnly(['providerId','providerName','providerPhone','docType','docUrl','docPath','addressProofUrl','cancelledChequeUrl','selfieUrl','selfiePath','idLast4','status','confirmationId','submittedAt']);
      allow update, delete: if false;
    }
    match /admin_alerts/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() && changedKeys().hasOnly(['read', 'status']);
      allow create, delete: if false;
    }
  }
}
